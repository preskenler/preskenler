# Copy this file to .env and fill in real values.

# MySQL / MariaDB connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Defaults match the local docker-compose.yml (root can create the shadow DB).
DATABASE_URL="mysql://root:root@localhost:3306/preskenler"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Auth emails (password reset, email verification, email change).
# No mail provider is configured yet: `src/lib/email.ts` logs messages to the
# server console in development. Add the real transport's variables here when
# one is wired up (e.g. SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, EMAIL_FROM).

# Server-side log threshold: debug | info | warn | error.
# Defaults to `debug` in development and `warn` in production. Ignored in the browser.
# LOG_LEVEL="debug"

# Terra Nova / Webcup API (https://24h.webcup.fr). Server-only: never prefix
# this with NEXT_PUBLIC_, the key must not reach the browser.
WEBCUP_API_KEY=""
WEBCUP_API_URL="https://24h.webcup.fr/wp-json/webcup/v1/requests"

# Bearer secret protecting `GET /api/webcup/sync`, called by the scheduler
# (cPanel cron, or Vercel Cron via CRON_SECRET). Generate with: openssl rand -base64 32
WEBCUP_CRON_SECRET=""
