// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id
  name          String    @db.Text
  email         String
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  role          String    @default("citizen") @db.VarChar(64)
  banned        Boolean   @default(false)
  banReason     String?   @db.Text
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  messages      ServiceMessage[]
  reports       ProblemReport[]
  appointments  Appointment[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?  @db.Text
  userAgent      String?  @db.Text
  impersonatedBy String?  @db.VarChar(191)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

// Demands broadcast by the City of Terra Nova API. `request_code` is the
// stable business identifier used to deduplicate refreshes.
model WebcupRequest {
  id               String   @id @default(cuid())
  requestCode      String   @unique @db.VarChar(32)
  remoteId         Int
  requesterName    String   @db.Text
  requesterType    String   @db.VarChar(64)
  messagePublic    String   @db.Text
  difficulty       String   @db.VarChar(32)
  difficultyLevel  Int
  xpBase           Int
  xpTimeBonus      Int
  xpTotal          Int
  xpAvailable      Int
  isInitial        Boolean  @default(false)
  visibleSinceWave Int      @default(0)
  arrivalType      String   @db.VarChar(32)
  waveNumber       Int?
  arrivalTime      String   @default("") @db.VarChar(16)
  groupName        String?  @db.VarChar(64)
  sortOrder        Int?
  isAiRelated      Boolean  @default(false)
  isAiRequest      Boolean  @default(false)
  firstSeenAt      DateTime @default(now())
  lastSyncedAt     DateTime @updatedAt

  @@index([difficultyLevel])
  @@index([waveNumber])
  @@index([isInitial])
  @@index([firstSeenAt])
  @@map("webcup_request")
}

// Current state of the stream (waves, counters), a single `current` row.
model WebcupSession {
  id                   String   @id @default("current")
  status               String   @db.VarChar(32)
  isRunning            Boolean  @default(false)
  currentWave          Int      @default(0)
  elapsedMinutes       Int      @default(0)
  visibleRequestsCount Int      @default(0)
  initialRequestsCount Int      @default(0)
  waveRequestsCount    Int      @default(0)
  nextWaveNumber       Int      @default(0)
  minutesUntilNextWave Int      @default(0)
  updatedAt            DateTime @updatedAt

  @@map("webcup_session")
}

// Messages sent by residents to municipal services (demande D04).
model ServiceMessage {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(191)
  service   String   @db.VarChar(64)
  message   String   @db.Text
  status    String   @default("new") @db.VarChar(16)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("service_message")
}

// General messages and alerts broadcast to residents (demandes D18, F29, F30
// and F31). Staff publish them; residents see the active ones as a banner and
// through the notification bell. `code` makes demo seeds idempotent.
model Broadcast {
  id              String    @id @default(cuid())
  code            String?   @unique @db.VarChar(64)
  title           String    @db.VarChar(160)
  body            String    @db.Text
  level           String    @default("info") @db.VarChar(16)
  topic           String    @default("general") @db.VarChar(32)
  audience        String    @default("all") @db.VarChar(32)
  area            String?   @db.VarChar(120)
  recommendations String?   @db.Text
  isAi            Boolean   @default(false)
  active          Boolean   @default(true)
  publishedAt     DateTime  @default(now())
  expiresAt       DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active, publishedAt])
  @@index([level])
  @@map("broadcast")
}

// Problems reported by residents on the public infrastructure — a broken
// street lamp, a pothole, uncollected waste… (demande F25). `reference` is the
// human-readable confirmation code shown right after submission (demande D16).
model ProblemReport {
  id          String   @id @default(cuid())
  reference   String   @unique @db.VarChar(24)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String   @db.VarChar(120)
  email       String   @db.VarChar(191)
  service     String   @db.VarChar(64)
  category    String   @db.VarChar(64)
  location    String   @db.VarChar(200)
  description String   @db.Text
  status      String   @default("new") @db.VarChar(16)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([service])
  @@index([createdAt])
  @@map("problem_report")
}

// Availability of a municipal service (demande F38). Keyed on the stable
// service slug from `src/lib/services.ts`; a row only exists once staff have
// changed the default "available" state.
model ServiceStatus {
  id             String    @id @default(cuid())
  service        String    @unique @db.VarChar(64)
  status         String    @default("available") @db.VarChar(16)
  message        String?   @db.Text
  expectedReturn DateTime?
  alternative    String?   @db.Text
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("service_status")
}

// Bookable appointment slots with an agent (demande F39). Staff publish slots;
// citizens pick one, so the chosen créneau is never ambiguous.
model AppointmentSlot {
  id              String        @id @default(cuid())
  service         String        @db.VarChar(64)
  startsAt        DateTime
  durationMinutes Int           @default(30)
  agentName       String?       @db.VarChar(120)
  location        String?       @db.VarChar(200)
  capacity        Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]

  @@unique([service, startsAt])
  @@index([startsAt])
  @@index([service])
  @@map("appointment_slot")
}

// A citizen's booking of a slot. `reminderSentAt` marks the reminder (F40).
model Appointment {
  id             String          @id @default(cuid())
  reference      String          @unique @db.VarChar(24)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  slotId         String
  slot           AppointmentSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  name           String          @db.VarChar(120)
  email          String          @db.VarChar(191)
  phone          String?         @db.VarChar(32)
  reason         String          @db.Text
  status         String          @default("booked") @db.VarChar(16)
  reminderSentAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([slotId])
  @@index([reminderSentAt])
  @@map("appointment")
}

// Security trail for sign-in activity (demande F37). The cybersecurity centre
// uses it to spot unusual attempts across several accounts.
model AuthAuditLog {
  id        String   @id @default(cuid())
  event     String   @db.VarChar(32)
  outcome   String   @db.VarChar(16)
  userId    String?
  email     String   @db.VarChar(191)
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
  @@map("auth_audit_log")
}
